{
  "name": "lamapoll-mailer",
  "version": "1.0.0",
  "description": "Sends an automatic confirmation e-mail for every new LamaPoll signup. Everything is configured in the admin UI.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2"
  }
}
